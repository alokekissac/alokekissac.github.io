# Copy to .env.local and fill in. Never commit real values.

# Absolute site URL (used for Open Graph, canonical URL, sitemap)
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# GitHub section ("Building in public") — leave empty to show clearly labelled sample data
GITHUB_USERNAME=
# Optional: a fine-grained token with no extra permissions, enables the real contribution calendar
GITHUB_TOKEN=

# Contact form email delivery via https://resend.com (server-side only)
RESEND_API_KEY=
CONTACT_TO_EMAIL=
# Optional verified sender, e.g. "Aloke <hello@your-domain.com>"
CONTACT_FROM_EMAIL=
